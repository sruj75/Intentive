# Copy to `.env`. Neon Auth base URL (public endpoint) — its Better Auth server's
# JWKS backs the shared verifier (#15). Consumed by
# src/domains/auth/service/neon-client.ts.
EXPO_PUBLIC_NEON_AUTH_BASE_URL=https://ep-lucky-dew-aqkjv8j5.neonauth.c-8.us-east-1.aws.neon.tech/neondb/auth

# Public Google iOS OAuth client ID for native Google Sign-In. The matching
# reversed URL scheme is generated by app.config.js; this is not a secret.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Public Google web OAuth client ID. Native Google Sign-In requests an ID token
# for this audience so Neon Auth can verify it using its configured web client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Control Plane base URL (public HTTPS). The real LaunchStateSource calls
# `${base}/me` to hydrate Launch State (#23). Consumed by
# src/providers/launch-state/control-plane-source.ts. Leave blank in dev: with no
# Neon session the source returns signed-out and never calls the Control Plane.
EXPO_PUBLIC_CONTROL_PLANE_BASE_URL=

# Public Sentry client DSN for errors-only Mobile Client reporting. Leave blank
# in local development to keep telemetry disabled.
EXPO_PUBLIC_SENTRY_DSN=

# Explicit local-only escape hatch for walking the post-auth UI in an Expo
# Development Client without Google, SecureStore, Control Plane, push, or Agent
# Runtime calls. Runtime config ignores this outside Expo __DEV__ builds.
EXPO_PUBLIC_DEV_AUTH_BYPASS=false
