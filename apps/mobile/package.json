{
  "name": "@intentive/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-esm-marker.mjs",
    "test": "pnpm --filter \"@intentive/mobile...\" run build && node --test",
    "test:rn": "jest",
    "typecheck": "tsc --noEmit",
    "dev": "expo start --dev-client --port 8082",
    "ios": "expo run:ios --port 8082",
    "ios:portable": "bash scripts/eas-local-build.sh --profile development --non-interactive",
    "android": "expo run:android",
    "eas:prepare": "pnpm --dir ../.. build",
    "eas:preflight": "pnpm run eas:prepare && expo export:embed --eager --platform ios --dev false",
    "eas-build-post-install": "pnpm run eas:prepare"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@expo/metro-runtime": "~57.0.7",
    "@intentive/api-contract": "workspace:*",
    "@intentive/domain-types": "workspace:*",
    "@intentive/protocol": "workspace:*",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@sentry/react-native": "~7.11.0",
    "better-auth": "1.6.23",
    "expo": "^57.0.8",
    "expo-constants": "^57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-device": "^57.0.1",
    "expo-linking": "^57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "^57.0.7",
    "expo-router": "^57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@testing-library/react-native": "*",
    "@types/react": "*",
    "babel-preset-expo": "~57.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
