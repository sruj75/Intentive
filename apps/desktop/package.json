{
  "name": "@intentive/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "acceptance:assembled": "bash macos/scripts/run-assembled-acceptance.sh",
    "build": "bash macos/scripts/swiftpm.sh build -c debug --package-path macos/Desktop",
    "desktop:accept": "bash macos/scripts/run-assembled-acceptance.sh",
    "desktop:check": "bash macos/scripts/test-with-coverage.sh && bash macos/scripts/verify-app-bundle.sh",
    "desktop:release-proof": "bash macos/scripts/run-stage2-release-proof.sh",
    "internal:build": "bash macos/scripts/tart-internal-build.sh --build",
    "internal:close": "bash macos/scripts/tart-internal-build.sh --delete",
    "internal:run": "bash macos/scripts/tart-internal-build.sh",
    "internal:status": "bash macos/scripts/tart-internal-build.sh --status",
    "release:acceptance:test": "bash macos/tests/test-signed-artifact-smoke.sh",
    "release:smoke": "bash macos/scripts/verify-app-bundle.sh",
    "typecheck": "bash macos/scripts/swiftpm.sh build -c debug --package-path macos/Desktop",
    "test": "bash macos/test.sh",
    "test:coverage": "bash macos/scripts/test-with-coverage.sh"
  }
}
