{
  "name": "intentive",
  "version": "0.0.0",
  "private": true,
  "description": "Intentive monorepo — Mobile, Desktop, Control Plane, Agent Runtime.",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "harness": "node tools/harness/run-harness.mjs",
    "harness:ci": "node tools/harness/run-harness.mjs",
    "harness:test": "node tools/harness/test.mjs",
    "ci:contracts": "node tools/ci/check-contracts.mjs",
    "ci:contracts:test": "node tools/ci/check-contracts.test.mjs",
    "ci:dependency-exceptions": "node tools/ci/check-dependency-exceptions.mjs",
    "ci:dependency-exceptions:test": "node tools/ci/check-dependency-exceptions.test.mjs",
    "ci:shell-portability": "node tools/ci/development-cleanup-contract.test.mjs && bash tools/ci/check-shell-portability.sh",
    "coverage:swift:test": "node tools/coverage/summarize-swift.test.mjs",
    "sensor:impact-radius": "node tools/sensors/impact-radius/index.mjs",
    "sensor:impact-radius:test": "node tools/sensors/impact-radius/test.mjs",
    "sensor:contract-drift": "node tools/sensors/contract-drift/index.mjs",
    "sensor:contract-drift:test": "node tools/sensors/contract-drift/test.mjs",
    "sensor:harness-health": "node tools/sensors/harness-health/index.mjs",
    "sensor:harness-health:test": "node tools/sensors/harness-health/test.mjs",
    "sensor:factory-report": "node tools/sensors/factory-report/index.mjs",
    "sensor:factory-report:test": "node tools/sensors/factory-report/test.mjs",
    "factory:ledger": "node tools/factory/ledger-cli.mjs",
    "factory:recommend": "node tools/factory/recommend-cli.mjs",
    "factory:test": "node tools/factory/finding-ids.test.mjs && node tools/factory/test.mjs",
    "docs:check": "node tools/docs/check-markdown-links.mjs && node tools/docs/check-context-vocabulary.mjs && node tools/docs/check-agent-docs.mjs && node tools/docs/check-factory-docs.mjs",
    "docs:links:test": "node --test tools/docs/check-markdown-links.test.mjs",
    "docs:context:test": "node tools/docs/check-context-vocabulary.test.mjs",
    "docs:agents:test": "node tools/docs/check-agent-docs.test.mjs",
    "docs:factory:test": "node tools/docs/check-factory-docs.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml}\"",
    "lint": "pnpm docs:check && eslint .",
    "lint:fix": "eslint . --fix",
    "lint:architecture:test": "node tools/linters/eslint-plugin-intentive-architecture/test.js",
    "test": "turbo run test",
    "coverage": "pnpm --dir apps/desktop test:coverage",
    "prepare": "husky",
    "hooks:pre-commit": "sh tools/hooks/run-pre-commit.sh",
    "hooks:staged-check": "node tools/hooks/check-staged.mjs",
    "dev": "turbo run dev",
    "development:status": "bash scripts/development-cleanup.sh --status",
    "development:kill": "bash scripts/development-cleanup.sh --kill",
    "development:clean": "bash scripts/development-cleanup.sh --kill",
    "development:prune": "bash scripts/development-cleanup.sh --prune-artifacts",
    "desktop:clean-host:status": "bash scripts/desktop-host-cleanup.sh --status",
    "desktop:clean-host": "bash scripts/desktop-host-cleanup.sh --reset",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@intentive/eslint-plugin-architecture": "workspace:*",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.5.2"
  },
  "lint-staged": {
    "*.{json,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs,cjs}": "prettier --write",
    "{apps,services,packages}/*/src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": "eslint --fix"
  }
}
